{
  "name": "todo-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "tgcloud push && tgcloud migrate --safe",
    "status": "tgcloud status",
    "run": "tgcloud run",
    "test": "node --import ./test/sdk/register.mjs --test test/unit.mjs && node --import ./test/sdk/register.mjs test/e2e.mjs",
    "test:unit": "node --import ./test/sdk/register.mjs --test test/unit.mjs"
  },
  "devDependencies": {
    "@tgcloud/cli": "^0.2.0"
  },
  "description": "Persian todo-list Telegram bot with mandatory channel join, for Telegram Serverless (tgcloud)"
}
