{
  "name": "whisper_bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Persian whisper (نجوا) Telegram bot with forced channel join, for Telegram Serverless (tgcloud)",
  "scripts": {
    "deploy": "tgcloud push && tgcloud migrate --safe",
    "status": "tgcloud status",
    "run": "tgcloud run",
    "test": "node --no-warnings test/static.mjs && node --no-warnings --import ./test/sdk/register.mjs test/e2e.mjs",
    "test:cloud": "node test/cloud/run-tests.mjs",
    "test:cloud:local": "node --no-warnings test/cloud/local-harness.mjs"
  },
  "devDependencies": {
    "@tgcloud/cli": "^0.2.0",
    "json5": "^2.2.3"
  }
}
