# Wanger News: copy to .env and fill in. NEVER commit .env (it is git-ignored).
# On GitHub Actions use Settings → Secrets and variables → Actions instead (see README.md).

# --- secrets ---------------------------------------------------------------------------------
# Bot token from @BotFather (only the token itself: 123456789:AA...)
WANGER_NEWS_BOT_TOKEN=
# PostgreSQL URL exactly as Neon/Supabase show it, e.g.
# postgresql://user:password@ep-example-123.eu-central-1.aws.neon.tech/neondb?sslmode=require
WANGER_NEWS_DATABASE_URL=

# --- channels (not secret) -------------------------------------------------------------------
# Phase 1 posts ONLY here. @username or numeric id (-100...). The bot must be an admin.
WANGER_NEWS_TEST_CHANNEL=
# The main channel is used from Phase 2 on.
WANGER_NEWS_MAIN_CHANNEL=
# Source channel: its posts are copied to the target unless already published. Bot = admin.
WANGER_NEWS_SOURCE_CHANNEL=

# --- people ----------------------------------------------------------------------------------
WANGER_NEWS_OWNER_ID=5557901897
# Extra admins, comma-separated numeric ids
WANGER_NEWS_ADMIN_IDS=

# --- logging ---------------------------------------------------------------------------------
WANGER_NEWS_LOG_LEVEL=INFO
# json (default) or text
WANGER_NEWS_LOG_FORMAT=json

# --- Phase 2 (not used yet) ------------------------------------------------------------------
# WANGER_NEWS_GEMINI_API_KEY=

# --- docker compose (option B) only ----------------------------------------------------------
POSTGRES_PASSWORD=change-me
