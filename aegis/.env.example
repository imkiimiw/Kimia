# Aegis — local settings for the CLI scripts (copy to aegis/.env; .env is git-ignored).
# Nothing here is ever committed or uploaded as code. The platform gives deployed modules
# no environment variables, so the only runtime value (AEGIS_OWNER_ID) is written into
# tgcloud/lib/env.js by `npm run build` / `npm run deploy` (scripts/gen-env.mjs).

# CLI access token: BotFather → your bot → Serverless → CLI Access → Access token.
# scripts/tg.mjs passes it to the tgcloud CLI as TGCLOUD_TOKEN. Never hardcode or commit it.
Aegis_BOT_TGCLOUD_TOKEN=

# Super Admin (owner) numeric Telegram id. Only this id opens the owner panel.
AEGIS_OWNER_ID=5557901897
