{
  // Aegis. The Mini App in webapp/ (plain HTML/JS, no build step), served at
  // https://app<app id>.tgcloud.ai/: the owner's live broadcast page (index.html, opened from the
  // owner panel), the join-request captcha Telegram opens when Aegis is a chat's guard bot (join.html),
  // the media tools page (media.html) and the public landing page (about.html; its texts are generated
  // into site-strings.js by scripts/build-locales.mjs).
  "$schema": "./node_modules/@tgcloud/cli/schema/tgcloud.json",
  "static": {
    "source": "webapp"
  }
}
