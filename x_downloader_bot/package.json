{
  "name": "x_downloader_bot",
  "private": true,
  "devDependencies": {
    "@tgcloud/cli": "^0.2.0",
    "json5": "^2.2.3"
  },
  "scripts": {
    "deploy": "tgcloud push && tgcloud migrate --safe",
    "status": "tgcloud status",
    "run": "tgcloud run",
    "test": "node --no-warnings --import ./test/sdk/register.mjs --test test/unit.mjs && node --no-warnings --import ./test/sdk/register.mjs test/e2e.mjs",
    "test:live": "NODE_USE_ENV_PROXY=1 node --no-warnings --import ./test/sdk/register.mjs test/live.mjs",
    "test:cloud": "node test/cloud/run-tests.mjs",
    "test:cloud:local": "NODE_USE_ENV_PROXY=1 node --no-warnings test/cloud/local-harness.mjs"
  },
  "type": "module",
  "description": "X/Twitter media downloader Telegram bot (Persian) for Telegram Serverless (tgcloud)"
}
