# Meme bot: local settings for the CLI scripts. Copy to memebot/.env (git-ignored) or set them in
# the environment (the environment wins). Nothing here is committed.

# CLI access token: BotFather -> your bot -> Serverless -> CLI Access -> Access token
# (looks like app<id>:<secret>; it is NOT the bot token). scripts/tg.mjs passes it to the tgcloud
# CLI as TGCLOUD_TOKEN for that one process. Never hardcode or commit it.
Meme_BOT_TGCLOUD_TOKEN=

# THE channel the bot posts to (default -1004475337598 = @WangerChaos; "off" = none).
# The bot must be an admin of the channel with "Post messages" and "Delete messages".
# Deployed code can't read env vars, so scripts/gen-env.mjs writes this into tgcloud/lib/env.js.
MEMEBOT_BACKUP_CHANNEL_ID=
# public (default): only approved memes are posted, as clean copies; a removed meme's post is deleted.
# all: every upload is forwarded as it is (a private archive). Only for a PRIVATE channel.
MEMEBOT_BACKUP_MODE=
# Meme of the day goes to the same channel unless set ("off" = no meme of the day).
MEMEBOT_MOTD_CHANNEL_ID=

# The owner's numeric Telegram id (gets backup-failure alerts, runs /setup). Default 5557901897.
MEMEBOT_OWNER_ID=
