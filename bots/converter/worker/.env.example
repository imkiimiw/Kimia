# Copy to .env and fill in. Never commit .env.
# The bot's token from @BotFather (the worker only downloads files and sends/edits messages with it;
# it never touches the webhook).
BOT_TOKEN=
# A long random shared secret (≥ 32 chars); give the same value to the bot with
#   /secret set WORKER_SECRET <value>
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
WORKER_SECRET=
# Public HTTPS name of this worker (for the Caddy profile); the bot gets https://<this> as WORKER_URL.
WORKER_DOMAIN=

# Optional tuning (defaults shown)
LIGHT_WORKERS=2
HEAVY_WORKERS=1
MAX_INPUT_MB=20
MAX_OUTPUT_MB=50
MAX_IMAGE_PIXELS=50000000
MAX_SIDE=12000
JOB_TIMEOUT_LIGHT_S=30
JOB_TIMEOUT_HEAVY_S=120
TEMP_RETENTION_MIN=30
MEMORY_LIMIT_MB=2048
LOG_LEVEL=INFO
# Bot API base URL. Keep the default, or point it at your own local Bot API server
# (telegram-bot-api --local) to lift the 20 MB download limit later.
TELEGRAM_API=https://api.telegram.org
