<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.Wanger" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text2</item>
    </style>
    <style name="Theme.Wanger" parent="Base.Theme.Wanger" />

    <style name="Wanger.Title" parent="android:TextAppearance.Material.Headline">
        <item name="android:textColor">@color/text</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Wanger.Body" parent="android:TextAppearance.Material.Body1">
        <item name="android:textColor">@color/text2</item>
    </style>
    <style name="Wanger.Button" parent="android:Widget.Material.Button">
        <item name="android:backgroundTint">@color/brand</item>
        <item name="android:textColor">@color/on_brand</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Wanger.Button.Soft">
        <item name="android:backgroundTint">@color/brand_soft</item>
        <item name="android:textColor">@color/text</item>
    </style>
</resources>
